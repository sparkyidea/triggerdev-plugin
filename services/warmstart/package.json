{
  "name": "trigger-warm-start-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Node.js warm-start matcher for self-hosted Trigger.dev workers",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "license": "MIT"
}
